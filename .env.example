# server (export these, or prefix the command)
PORT=8080
MONGO_URL=mongodb://localhost:27017
MONGO_DB=proxispeak
REDIS_URL=redis://localhost:6379
ADMIN_TOKEN=change-me          # required header x-admin-token for PUT /api/rooms/:id/layout

# client (client/.env) - optional TURN for users behind strict NATs
